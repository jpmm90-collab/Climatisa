// Prisma schema — Cotizador de Aires Acondicionados (Climatisa)
// Provider: PostgreSQL en Railway (excepción confirmada, ver CLAUDE.md).
// Modelo conceptual completo (skill secciones 22 y 43) definido desde Fase 1
// para evitar migraciones fragmentadas; el resto de fases solo agrega UI/lógica.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COTIZADOR
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  AMOUNT
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String
  company   String
  // NIT es siempre string; acepta "CF" explícitamente. Nunca convertir a número.
  nit       String
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotes Quote[]

  @@map("clients")
}

model Equipment {
  id        String   @id @default(cuid())
  name      String
  brand     String
  model     String
  btu       Int
  type      String
  price     Decimal  @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quoteAreaEquipments QuoteAreaEquipment[]

  @@map("equipment")
}

// Rangos de metros: min_meters <= meters < max_meters. max_meters NULL = sin límite superior.
// Sin solapes, sin duplicados. Validado en la capa de administración, no solo en DB.
model InstallationKit {
  id         String   @id @default(cuid())
  minMeters  Decimal  @map("min_meters") @db.Decimal(6, 2)
  maxMeters  Decimal? @map("max_meters") @db.Decimal(6, 2)
  price      Decimal  @db.Decimal(12, 2)
  active     Boolean  @default(true)

  quoteAreaEquipments QuoteAreaEquipment[]

  @@map("installation_kits")
}

model Complexity {
  id          String   @id @default(cuid())
  level       Int      @unique
  name        String
  description String
  adjustment  Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)

  quoteAreaEquipments QuoteAreaEquipment[]

  @@map("complexities")
}

// Configuración única de empresa. En la práctica se espera una sola fila.
model CompanySettings {
  id                       String   @id @default(cuid())
  companyName              String   @map("company_name")
  logoUrl                  String?  @map("logo_url")
  phone                    String
  email                    String
  address                  String
  commercialTerms          String?  @map("commercial_terms") @db.VarChar(2000)
  defaultDepositPercentage Decimal  @default(50) @map("default_deposit_percentage") @db.Decimal(5, 2)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

// Secuencia atómica para el número de cotización (COT-2026-000123).
// Un UPSERT atómico por año evita condiciones de carrera; nunca count(*) + 1.
model QuoteNumberCounter {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("quote_number_counters")
}

model Quote {
  id                     String        @id @default(cuid())
  quoteNumber            String        @unique @map("quote_number")
  clientId               String        @map("client_id")
  date                   DateTime      @default(now())
  subtotal               Decimal       @db.Decimal(12, 2)
  discountType           DiscountType  @map("discount_type")
  discountValue          Decimal       @map("discount_value") @db.Decimal(12, 2)
  discountAmount         Decimal       @map("discount_amount") @db.Decimal(12, 2)
  total                  Decimal       @db.Decimal(12, 2)
  depositPercentage      Decimal       @map("deposit_percentage") @db.Decimal(5, 2)
  depositAmount          Decimal       @map("deposit_amount") @db.Decimal(12, 2)
  balance                Decimal       @db.Decimal(12, 2)
  // Texto base obligatorio de instalación (19.5) + texto adicional editable por el usuario.
  installationNotesExtra String?       @map("installation_notes_extra") @db.VarChar(500)
  additionalDescription  String?       @map("additional_description") @db.VarChar(500)
  status                 QuoteStatus   @default(DRAFT)
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  client Client      @relation(fields: [clientId], references: [id])
  areas  QuoteArea[]
  extras QuoteExtra[]

  @@map("quotes")
}

model QuoteArea {
  id        String @id @default(cuid())
  quoteId   String @map("quote_id")
  name      String @db.VarChar(60)
  areaTotal Decimal @map("area_total") @db.Decimal(12, 2)

  quote     Quote                @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  equipment QuoteAreaEquipment[]

  @@map("quote_areas")
}

// Línea de equipo instalado dentro de un área. El kit y la complejidad son
// por unidad de equipo instalado (sección 43). Guarda snapshots históricos
// completos para que una cotización guardada nunca cambie si el catálogo cambia después.
model QuoteAreaEquipment {
  id            String  @id @default(cuid())
  quoteAreaId   String  @map("quote_area_id")
  equipmentId   String  @map("equipment_id")
  quantity      Int     @default(1)
  meters        Decimal @db.Decimal(6, 2)
  installationKitId String @map("installation_kit_id")
  complexityId  String  @map("complexity_id")

  equipmentNameSnapshot            String  @map("equipment_name_snapshot")
  equipmentPriceSnapshot           Decimal @map("equipment_price_snapshot") @db.Decimal(12, 2)
  installationKitPriceSnapshot     Decimal @map("installation_kit_price_snapshot") @db.Decimal(12, 2)
  complexityAdjustmentSnapshot     Decimal @map("complexity_adjustment_snapshot") @db.Decimal(12, 2)
  installationPriceSnapshot        Decimal @map("installation_price_snapshot") @db.Decimal(12, 2)
  lineTotal                        Decimal @map("line_total") @db.Decimal(12, 2)

  quoteArea       QuoteArea       @relation(fields: [quoteAreaId], references: [id], onDelete: Cascade)
  equipment       Equipment       @relation(fields: [equipmentId], references: [id])
  installationKit InstallationKit @relation(fields: [installationKitId], references: [id])
  complexity      Complexity      @relation(fields: [complexityId], references: [id])

  @@map("quote_area_equipment")
}

model QuoteExtra {
  id          String  @id @default(cuid())
  quoteId     String  @map("quote_id")
  description String  @db.VarChar(200)
  price       Decimal @db.Decimal(12, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_extras")
}
