# Postgres (Railway — excepción confirmada, ver CLAUDE.md)
# connection_limit/pool_timeout recomendados: la creación de cotizaciones usa
# una transacción interactiva (número atómico + escritura); bajo ráfagas de
# solicitudes concurrentes el pool por defecto de Prisma se agota rápido.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&connection_limit=20&pool_timeout=20"

# Auth.js
NEXTAUTH_SECRET="genera-con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# CompanySettings iniciales (opcional, también se puede administrar desde ADMIN)
NEXT_PUBLIC_COMPANY_NAME="Climatisa"
