# Postgres (Neon o Supabase — elegir uno y mantenerlo fijo)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js
NEXTAUTH_SECRET="genera-con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# CompanySettings iniciales (opcional, también se puede administrar desde ADMIN)
NEXT_PUBLIC_COMPANY_NAME="Climatisa"
